# 数据库
DATABASE_URL="file:./dev.db"

# 会话密钥（生产环境请修改）
SESSION_SECRET="cultivation-dev-secret-please-change-in-prod"

# 管理员密钥（settings 页面用）
ADMIN_KEY="dev-admin-key"

# ── AI 叙事供应方配置 ──────────────────────────────────
# 代码读取 AI_PROVIDER_{1..3} 系列变量，支持最多 3 个备选。
# 按优先级从 AI_PROVIDER_1 开始尝试，失败自动切换到下一个。

# 供应方 1：Anthropic（推荐）
AI_PROVIDER_1="anthropic"
AI_PROVIDER_1_KEY="sk-ant-你的API密钥"
AI_PROVIDER_1_MODEL="claude-sonnet-4-20250514"

# 供应方 2：OpenAI（备选）
# AI_PROVIDER_2="openai"
# AI_PROVIDER_2_KEY="sk-你的API密钥"
# AI_PROVIDER_2_MODEL="gpt-4o"

# 供应方 3：本地 Ollama（免费，备选）
# AI_PROVIDER_3="ollama"
# AI_PROVIDER_3_MODEL="qwen2.5"
# AI_PROVIDER_3_BASE_URL="http://localhost:11434"